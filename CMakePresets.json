{
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/install",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },

    {
      "name": "developer",
      "hidden": true,
      "cacheVariables": {
        "EXTORA_BUILD_BENCHMARKS": "ON",
        "EXTORA_BUILD_EXAMPLES": "ON",
        "EXTORA_BUILD_HTTP_SERVER_EXAMPLE": "ON",
        "EXTORA_BUILD_ASIO_ADAPTER": "ON",
        "EXTORA_BUILD_TESTS": "ON"
      }
    },

    {
      "name": "tests-only",
      "hidden": true,
      "cacheVariables": {
        "EXTORA_BUILD_TESTS": "ON"
      }
    },

    {
      "name": "gcc",
      "hidden": true,
      "generator": "Ninja",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "environment": { "CC": "gcc", "CXX": "g++" }
    },

    {
      "name": "clang",
      "hidden": true,
      "generator": "Ninja",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "environment": { "CC": "clang", "CXX": "clang++" }
    },

    {
      "name": "msvc",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },

    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },

    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "relwithdebinfo",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },

    {
      "name": "static",
      "hidden": true,
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "EXTORA_BUILD_STATIC_AND_SHARED": "OFF"
      }
    },

    {
      "name": "shared",
      "hidden": true,
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "EXTORA_BUILD_STATIC_AND_SHARED": "OFF"
      }
    },

    {
      "name": "static-and-shared",
      "hidden": true,
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF",
        "EXTORA_BUILD_STATIC_AND_SHARED": "ON"
      }
    },

    {
      "name": "gcc-debug-static",
      "displayName": "GCC / Debug / Static",
      "inherits": [ "base", "developer", "gcc", "debug", "static" ]
    },

    {
      "name": "gcc-debug-shared",
      "displayName": "GCC / Debug / Shared",
      "inherits": [ "base", "developer", "gcc", "debug", "shared" ]
    },

    {
      "name": "gcc-debug-static-and-shared",
      "displayName": "GCC / Debug / Static and Shared",
      "inherits": [ "base", "developer", "gcc", "debug", "static-and-shared" ]
    },

    {
      "name": "gcc-release-static",
      "displayName": "GCC / Release / Static",
      "inherits": [ "base", "developer", "gcc", "release", "static" ]
    },

    {
      "name": "gcc-release-shared",
      "displayName": "GCC / Release / Shared",
      "inherits": [ "base", "developer", "gcc", "release", "shared" ]
    },

    {
      "name": "gcc-release-static-and-shared",
      "displayName": "GCC / Release / Static and Shared",
      "inherits": [ "base", "developer", "gcc", "release", "static-and-shared" ]
    },

    {
      "name": "gcc-relwithdebinfo-static",
      "displayName": "GCC / RelWithDebInfo / Static",
      "inherits": [ "base", "developer", "gcc", "relwithdebinfo", "static" ]
    },

    {
      "name": "gcc-relwithdebinfo-shared",
      "displayName": "GCC / RelWithDebInfo / Shared",
      "inherits": [ "base", "developer", "gcc", "relwithdebinfo", "shared" ]
    },

    {
      "name": "gcc-relwithdebinfo-static-and-shared",
      "displayName": "GCC / RelWithDebInfo / Static and Shared",
      "inherits": [ "base", "developer", "gcc", "relwithdebinfo", "static-and-shared" ]
    },

    {
      "name": "clang-debug-static",
      "displayName": "Clang / Debug / Static",
      "inherits": [ "base", "developer", "clang", "debug", "static" ]
    },

    {
      "name": "clang-debug-shared",
      "displayName": "Clang / Debug / Shared",
      "inherits": [ "base", "developer", "clang", "debug", "shared" ]
    },

    {
      "name": "clang-debug-static-and-shared",
      "displayName": "Clang / Debug / Static and Shared",
      "inherits": [ "base", "developer", "clang", "debug", "static-and-shared" ]
    },

    {
      "name": "clang-release-static",
      "displayName": "Clang / Release / Static",
      "inherits": [ "base", "developer", "clang", "release", "static" ]
    },

    {
      "name": "clang-release-shared",
      "displayName": "Clang / Release / Shared",
      "inherits": [ "base", "developer", "clang", "release", "shared" ]
    },

    {
      "name": "clang-release-static-and-shared",
      "displayName": "Clang / Release / Static and Shared",
      "inherits": [ "base", "developer", "clang", "release", "static-and-shared" ]
    },

    {
      "name": "clang-relwithdebinfo-static",
      "displayName": "Clang / RelWithDebInfo / Static",
      "inherits": [ "base", "developer", "clang", "relwithdebinfo", "static" ]
    },

    {
      "name": "clang-relwithdebinfo-shared",
      "displayName": "Clang / RelWithDebInfo / Shared",
      "inherits": [ "base", "developer", "clang", "relwithdebinfo", "shared" ]
    },

    {
      "name": "clang-relwithdebinfo-static-and-shared",
      "displayName": "Clang / RelWithDebInfo / Static and Shared",
      "inherits": [ "base", "developer", "clang", "relwithdebinfo", "static-and-shared" ]
    },

    {
      "name": "msvc-static",
      "displayName": "MSVC / Static",
      "inherits": [ "base", "developer", "msvc", "static" ]
    },

    {
      "name": "msvc-shared",
      "displayName": "MSVC / Shared",
      "inherits": [ "base", "developer", "msvc", "shared" ]
    },

    {
      "name": "msvc-static-and-shared",
      "displayName": "MSVC / Static and Shared",
      "inherits": [ "base", "developer", "msvc", "static-and-shared" ]
    },

    {
      "name": "gcc-debug-static-coverage",
      "displayName": "GCC / Debug / Static / Coverage",
      "inherits": [ "base", "tests-only", "gcc", "debug", "static" ],
      "cacheVariables": {
        "EXTORA_ENABLE_COVERAGE": "ON"
      }
    },

    {
      "name": "clang-debug-static-asan-ubsan",
      "displayName": "Clang / Debug / Static / ASan and UBSan",
      "inherits": [ "base", "developer", "clang", "debug", "static" ],
      "cacheVariables": {
        "EXTORA_ENABLE_SANITIZERS": "ON"
      }
    },

    {
      "name": "clang-debug-shared-asan-ubsan",
      "displayName": "Clang / Debug / Shared / ASan and UBSan",
      "inherits": [ "base", "developer", "clang", "debug", "shared" ],
      "cacheVariables": {
        "EXTORA_ENABLE_SANITIZERS": "ON"
      }
    },

    {
      "name": "clang-debug-static-tsan",
      "displayName": "Clang / Debug / Static / ThreadSanitizer",
      "inherits": [ "base", "developer", "clang", "debug", "static" ],
      "cacheVariables": {
        "EXTORA_ENABLE_THREAD_SANITIZER": "ON"
      }
    },

    {
      "name": "clang-debug-shared-tsan",
      "displayName": "Clang / Debug / Shared / ThreadSanitizer",
      "inherits": [ "base", "developer", "clang", "debug", "shared" ],
      "cacheVariables": {
        "EXTORA_ENABLE_THREAD_SANITIZER": "ON"
      }
    }
  ],

